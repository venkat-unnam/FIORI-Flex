<mvc:View
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:svm="sap.ui.comp.smartvariants"
	xmlns:macros="sap.fe.macros"
	xmlns:html="http://www.w3.org/1999/xhtml" 
        controllerName="yvui5flex1.ext.view.Main">
	<f:DynamicPage headerExpanded="{/headerExpanded}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Filter Bar"/>
				</f:heading>
				<f:snappedContent>
					<Panel headerText="Filter Text" >
						<Text text="{fbConditions>/filtersTextInfo}"/>
					</Panel>
					<Panel headerText="Highest Price Tiles">
						<HeaderContainer scrollStep="200" showDividers="false" content="{ path: '/Travel',
                                parameters: {
                                    $filter: 'TravelStatus_code eq \'O\' and IsActiveEntity eq false or SiblingEntity/IsActiveEntity eq null',
                                    $orderby: 'TotalPrice desc'
                                    }
                                }">
							<GenericTile header="Travel {TravelID}" subheader="{Description}" press=".handlers.onTilePress">
								<TileContent unit="{CurrencyCode_code}" footer="{to_Customer/LastName}">
									<NumericContent value="{TotalPrice}" valueColor="Good" scale="k"/>
								</TileContent>
							</GenericTile>
						</HeaderContainer>
					</Panel>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<macros:FilterBar id="FilterBar" metaPath="/Travel/@com.sap.vocabularies.UI.v1.SelectionFields"
                            filterChanged=".handlers.onFiltersChanged"/>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<macros:Table id="LineItemTable" metaPath="/Travel/@com.sap.vocabularies.UI.v1.LineItem" readOnly="true" filterBar="FilterBar"/>
		</f:content>
	</f:DynamicPage>
</mvc:View>